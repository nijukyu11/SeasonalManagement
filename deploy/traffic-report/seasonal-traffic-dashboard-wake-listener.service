[Unit]
Description=Wake the Daily Dashboard runner after canonical Daily Import commit
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/sbin/seasonal-traffic-dashboard-runner listen
Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
