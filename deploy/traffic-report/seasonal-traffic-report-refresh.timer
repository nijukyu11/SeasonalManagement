[Unit]
Description=Optional safety refresh for the public traffic report aggregate

[Timer]
# Staging policy: keep this timer disabled and refresh manually before acceptance.
# The five-minute schedule is retained only as a safer rollback/safety option.
OnBootSec=5m
OnUnitInactiveSec=5m
AccuracySec=1s
Persistent=true
Unit=seasonal-traffic-report-refresh.service

[Install]
WantedBy=timers.target
