[Unit]
Description=Manually refresh the public traffic report aggregate snapshot
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec opsdata-supabase-db psql -X -v ON_ERROR_STOP=1 -U supabase_admin -d postgres -c "REFRESH MATERIALIZED VIEW CONCURRENTLY reporting.public_traffic_effective"
TimeoutStartSec=25
NoNewPrivileges=true
